// src/features/fault-diagnosis/components/DiagnosisResult.jsx
import React from 'react';
import { CheckCircle, AlertTriangle, Download, Clock, DollarSign, Target, Wrench } from 'lucide-react';
import { TypewriterResult } from '../../../shared/components/Common/TypewriterResult';

export const DiagnosisResult = ({ diagnosis, repairRecommendations, onGenerateReport, onAcceptDiagnosis }) => {
  const getConfidenceColor = (confidence) => {
    if (confidence >= 80) return 'text-green-600';
    if (confidence >= 60) return 'text-yellow-600';
    return 'text-red-600';
  };

  const getConfidenceBar = (confidence) => {
    const width = `${confidence}%`;
    let color = 'bg-green-500';
    if (confidence < 60) color = 'bg-red-500';
    else if (confidence < 80) color = 'bg-yellow-500';
    
    return (
      <div className="w-full bg-gray-200 rounded-full h-2">
        <div className={`${color} h-2 rounded-full transition-all duration-500`} style={{ width }}></div>
      </div>
    );
  };

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex justify-between items-start">
        <div>
          {diagnosis.personalizedGreeting && (
            <div className="bg-blue-50 border-l-4 border-blue-200 p-4 rounded-lg mb-6">
              <TypewriterResult 
                text={diagnosis.personalizedGreeting}
                speed={25}
                className="text-blue-800 font-medium"
              />
            </div>
          )}
          <TypewriterResult 
            text="Diagnosis Complete"
            speed={40}
            className="text-2xl font-bold text-gray-900"
          />
          <TypewriterResult 
            text="AI-powered analysis results"
            speed={35}
            className="text-gray-600 mt-1"
          />
        </div>
        <button
          onClick={onGenerateReport}
          className="flex items-center px-4 py-2 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
        >
          <Download className="w-4 h-4 mr-2" />
          Download Report
        </button>
      </div>

      {/* Confidence Score */}
      <div className="bg-gray-50 rounded-lg p-4">
        <div className="flex justify-between items-center mb-2">
          <span className="font-medium text-gray-700">Diagnosis Confidence</span>
          <span className={`font-bold ${getConfidenceColor(diagnosis.confidence)}`}>
            {diagnosis.confidence}%
          </span>
        </div>
        {getConfidenceBar(diagnosis.confidence)}
      </div>

      {/* Fault Details */}
      <div className="border-t pt-4">
        <h3 className="font-semibold text-gray-900 mb-2">Fault Code: {diagnosis.faultCode}</h3>
        <div className="mb-4">
          <TypewriterResult 
            text={diagnosis.description}
            speed={30}
            className="text-gray-700 leading-relaxed"
          />
        </div>
      </div>

      {/* Quick Info Cards */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div className="bg-blue-50 rounded-lg p-3">
          <div className="flex items-center space-x-2">
            <Clock className="w-4 h-4 text-blue-600" />
            <span className="text-sm text-gray-600">Est. Repair Time</span>
          </div>
          <p className="font-semibold text-blue-900 mt-1">{diagnosis.estimatedTime}</p>
        </div>
        <div className="bg-green-50 rounded-lg p-3">
          <div className="flex items-center space-x-2">
            <DollarSign className="w-4 h-4 text-green-600" />
            <span className="text-sm text-gray-600">Est. Cost</span>
          </div>
          <p className="font-semibold text-green-900 mt-1">${diagnosis.estimatedRepairCost}</p>
        </div>
        <div className="bg-purple-50 rounded-lg p-3">
          <div className="flex items-center space-x-2">
            <Target className="w-4 h-4 text-purple-600" />
            <span className="text-sm text-gray-600">Skill Level</span>
          </div>
          <p className="font-semibold text-purple-900 mt-1">{diagnosis.skillLevel}</p>
        </div>
      </div>

      {/* Possible Causes - Only show if there are alternatives */}
      {diagnosis.possibleCauses && diagnosis.possibleCauses.length > 0 && (
        <div>
          <h3 className="font-semibold text-gray-900 mb-3">Alternative Diagnoses</h3>
          <ul className="space-y-2">
            {diagnosis.possibleCauses.map((cause, index) => (
              <li key={index} className="flex items-start space-x-2">
                <AlertTriangle className="w-4 h-4 text-yellow-500 mt-0.5" />
                <span className="text-gray-700">{cause}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {/* Affected Components */}
      <div>
        <h3 className="font-semibold text-gray-900 mb-3">Affected Components</h3>
        <div className="flex flex-wrap gap-2">
          {diagnosis.affectedComponents.map((component, index) => (
            <span key={index} className="px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm">
              {component}
            </span>
          ))}
        </div>
      </div>

      {/* Similar Cases */}
      {diagnosis.similarCases && diagnosis.similarCases.length > 0 && (
        <div>
          <h3 className="font-semibold text-gray-900 mb-3">Similar Past Cases</h3>
          <div className="space-y-2">
            {diagnosis.similarCases.map((case_, index) => (
              <div key={index} className="bg-gray-50 rounded-lg p-3">
                <div className="flex justify-between items-center">
                  <span className="font-medium text-gray-900">{case_.deviceModel}</span>
                  <span className="text-sm text-green-600">Success: {case_.successRate}%</span>
                </div>
                <p className="text-sm text-gray-600 mt-1">Resolution: {case_.resolution}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Repair Recommendations */}
      {repairRecommendations && (
        <div className="border-t pt-4 space-y-4">
          <h3 className="font-semibold text-gray-900 flex items-center">
            <Wrench className="w-4 h-4 mr-2 text-blue-600" />
            Repair Recommendations
          </h3>

          <div className="bg-blue-50 rounded-lg p-4">
            <p className="text-sm text-blue-900">
              Fault Type: <span className="font-semibold">{repairRecommendations.faultType}</span>
            </p>
            <p className="text-sm text-blue-900 mt-1">
              Est. Time: <span className="font-semibold">{repairRecommendations.estimatedTime} mins</span> | Est. Cost: <span className="font-semibold">${repairRecommendations.estimatedCost}</span>
            </p>
          </div>

          <div>
            <h4 className="font-medium text-gray-800 mb-2">Repair Procedure</h4>
            <ul className="space-y-2">
              {(repairRecommendations.repairProcedure || []).map((step, index) => (
                <li key={index} className="text-sm text-gray-700 bg-gray-50 rounded p-2">{step}</li>
              ))}
            </ul>
          </div>

          <div>
            <h4 className="font-medium text-gray-800 mb-2">Required Tools</h4>
            <div className="flex flex-wrap gap-2">
              {(repairRecommendations.requiredTools || []).map((tool, index) => (
                <span key={index} className="px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-sm">
                  {tool}
                </span>
              ))}
            </div>
          </div>

          <div>
            <h4 className="font-medium text-gray-800 mb-2">Required Parts</h4>
            <div className="flex flex-wrap gap-2">
              {(repairRecommendations.requiredParts || []).map((part, index) => (
                <span key={index} className="px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full text-sm">
                  {part}
                </span>
              ))}
            </div>
          </div>

          <div>
            <h4 className="font-medium text-gray-800 mb-2">Safety Precautions</h4>
            <ul className="space-y-1">
              {(repairRecommendations.safetyPrecautions || []).map((item, index) => (
                <li key={index} className="text-sm text-gray-700">- {item}</li>
              ))}
            </ul>
          </div>
        </div>
      )}

      {/* Action Buttons */}
      <div className="flex space-x-3 pt-4 border-t">
        <button
          onClick={() => onAcceptDiagnosis(diagnosis)}
          className="flex-1 bg-green-600 text-white py-3 rounded-lg hover:bg-green-700 transition-colors font-medium flex items-center justify-center"
        >
          <CheckCircle className="w-4 h-4 mr-2" />
          Accept & Continue to Repair
        </button>
        <button className="flex-1 bg-gray-600 text-white py-3 rounded-lg hover:bg-gray-700 transition-colors font-medium">
          Request Second Opinion
        </button>
      </div>
    </div>
  );
};